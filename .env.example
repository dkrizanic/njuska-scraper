# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://njuskalo:njuskalo_pass@localhost:5432/njuskalo_db
POSTGRES_USER=njuskalo
POSTGRES_PASSWORD=njuskalo_pass
POSTGRES_DB=njuskalo_db
POSTGRES_PORT=5432

# Browser & Anti-Bot Settings
# Keep HEADLESS=false especially on the first run so ShieldSquare / Cloudflare passes smoothly
# or lets you solve a one-time CAPTCHA that gets saved in your persistent browser profile.
HEADLESS=false
BROWSER_PROFILE_DIR=./browser_profile
MIN_DELAY_SECONDS=2.5
MAX_DELAY_SECONDS=5.5
PAGE_TIMEOUT_MS=45000
